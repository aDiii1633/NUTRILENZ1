# Add the SAME project URL and public publishable key to BOTH Vercel projects.
# Never use a service_role / secret key in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Admin's "Open website" link. Replace with your deployed PUBLIC site URL.
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173
# Public website's Vercel SERVER environment only, never prefix this with VITE_.
# Required for trusted image checks; never commit its actual value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Server only. Username login provisions the configured allowlisted owner once
# the schema is ready. Keep the password hash out of Git and browser variables.
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=YOUR_SCRYPT_PASSWORD_HASH
